# Railway → keeper service → Variables. Mark KEEPER_PRIVATE_KEY and PINATA_JWT as sealed/secret.
NETWORK=mainnet
RPC_URL=https://rpc.mainnet.fastnear.com
CORE_CONTRACT=core.whatthenft.near
BUYBACK_CONTRACT=buyback.whatthenft.near
KEEPER_ACCOUNT=keeper.whatthenft.near          # core operator + buyback keeper
KEEPER_PRIVATE_KEY=               # ed25519:... — a function-call-only key is enough; NEVER commit or paste in chat
PINATA_JWT=                       # Pinata API JWT for NFT images
# Buyback rules (defaults shown)
THRESHOLD_USD=20
MIN_HOLDING_WTH=1000
MIN_PAYOUT_WTH=1
EXCLUDE=
