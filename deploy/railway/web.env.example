# Railway → web service → Variables. NEXT_PUBLIC_* are baked in at BUILD time: redeploy after changing them.
NEXT_PUBLIC_NETWORK=mainnet
NEXT_PUBLIC_CORE_CONTRACT=core.whatthenft.near
NEXT_PUBLIC_MARKET_CONTRACT=market.whatthenft.near
# Optional, comma-separated, failover order (recommended: a dedicated RPC provider)
NEXT_PUBLIC_RPC_URLS=https://rpc.mainnet.fastnear.com,https://rpc.mainnet.near.org
QUOTE_NETWORK=mainnet
QUOTE_RPC_URLS=https://rpc.mainnet.fastnear.com,https://rpc.mainnet.near.org
