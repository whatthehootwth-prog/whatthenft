# Network the web app reads from and signs on. testnet | mainnet
NEXT_PUBLIC_NETWORK=testnet
# Deployed core contract (wtn-core). Leave empty until deployed: the UI shows an honest
# "contracts not deployed" state and disables every transaction.
NEXT_PUBLIC_CORE_CONTRACT=
# Marketplace contract (Milestone B). Empty => marketplace shows "not deployed".
NEXT_PUBLIC_MARKET_CONTRACT=
# Optional comma-separated RPC URLs (failover order). Defaults to public endpoints.
NEXT_PUBLIC_RPC_URLS=
# Quote API reads mainnet liquidity for the season pool (dry, read-only) regardless of
# NEXT_PUBLIC_NETWORK, because testnet has no real meme liquidity.
QUOTE_NETWORK=mainnet
